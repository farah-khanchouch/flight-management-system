# Variables d'environnement pour Flight Management System
# ======================================================

# Base de données PostgreSQL
DB_PASSWORD=farah123456789

# JWT Configuration
JWT_SECRET=3cfa76ef14937c1c0ea519f8fc057a80fcd04a7420f8e8bcd0a7567c272e007b
JWT_EXPIRATION=86400000

# Profil Spring
SPRING_PROFILES_ACTIVE=dev

# Configuration DDL (update pour dev, validate pour prod)
DDL_AUTO=update
SHOW_SQL=true

# Logging Levels
LOG_LEVEL=INFO
SECURITY_LOG_LEVEL=INFO
SQL_LOG_LEVEL=DEBUG
BINDER_LOG_LEVEL=TRACE

# CORS Origins (ajouter vos origines frontend)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:8080

# ======================================================
# Instructions d'utilisation :
#
# 1. Copier ce fichier et le renommer en .env.local pour vos modifications locales
# 2. Ne pas committer .env.local dans Git (il est ignoré par .gitignore)
# 3. Pour la production, définir SPRING_PROFILES_ACTIVE=prod
# 4. Changer JWT_SECRET par une valeur sécurisée en production
# ======================================================
